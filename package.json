{
  "name": "qodex",
  "version": "0.2.0",
  "private": true,
  "description": "Codex-powered autonomous QQ conversations with local memory, sticker learning and a Windows management console.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Control.ps1 -Action Start",
    "test:audit": "node scripts/test-audit.mjs",
    "self-test": "node src/self-test.js",
    "test-md": "node scripts/test-md-to-plain.mjs",
    "test-wait": "node scripts/test-v2-wait.mjs",
    "test-wait:e2e": "node scripts/test-dsh-v2-wait.mjs",
    "test-vision": "node scripts/test-vision-media.mjs",
    "test-forward": "node scripts/test-forward.mjs",
    "test-slang": "node scripts/test-slang-learn.mjs",
    "test-stickers": "node scripts/test-stickers.mjs",
    "test-console": "node scripts/test-console.mjs",
    "verify:adaptation": "node scripts/verify-dsh-015-adaptation.mjs",
    "verify:persona": "node scripts/verify-persona-config.mjs",
    "test:mcp-servers": "node scripts/test-mcp-servers-stdio.mjs",
    "test:plugin": "node scripts/test-qq-mode-plugin.mjs",
    "test:setup-idempotent": "node scripts/test-setup-dsh-idempotent.mjs",
    "test:mux-reconnect": "node scripts/test-mux-reconnect.mjs",
    "probe:events": "node scripts/probe-events.mjs",
    "probe:tools": "node scripts/probe-tools.mjs",
    "postinstall": "node scripts/patch-snowluma-sdk.mjs",
    "test": "node scripts/test-release.mjs",
    "test:deployment": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-deployment.ps1",
    "test:portable": "node scripts/test-portable-memory.mjs",
    "preview": "node scripts/preview-model-console.mjs",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Control.ps1 -Action Stop",
    "status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Control.ps1 -Action Status",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File Setup.ps1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.10",
    "@snowluma/sdk": "^1.14.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisZ-123/Qodex.git"
  },
  "homepage": "https://github.com/ChrisZ-123/Qodex#readme"
}
